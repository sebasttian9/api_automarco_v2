# Copiar este archivo a ".env" (o cargar estas mismas variables por el medio
# que use el proceso en el servidor: PM2 ecosystem file, systemd, variables de
# entorno de Windows, etc.). Nunca commitear un archivo ".env" con valores reales.

# Clave para firmar/verificar los JWT (generartokendb.js y el servidor deben usar
# la misma). Generar un valor largo y aleatorio, no una palabra de diccionario.
JWT_SECRET=

# Puerto en el que escucha este proceso (v2 usa 3008 mientras convive con v1 en 3000)
PORT=3008

# Base de datos "gestioncar" (catalogo: marcas, categorias, modelos) - config/bd.js y bd2.js
DB_GESTIONCAR_HOST=
DB_GESTIONCAR_PORT=3306
DB_GESTIONCAR_USER=
DB_GESTIONCAR_PASSWORD=
DB_GESTIONCAR_DATABASE=gestioncar

# Base de datos principal (permisos, pedidos, logs, sucursales, transportes,
# catalogo de productos por vehiculo) - config/bdPedidosApi.js
# IMPORTANTE: confirmar con el equipo si en produccion esto debe apuntar al mismo
# host que DB_GESTIONCAR_* o a uno distinto (hallazgo C7 del plan de pruebas).
DB_PEDIDOS_HOST=
DB_PEDIDOS_PORT=3306
DB_PEDIDOS_USER=
DB_PEDIDOS_PASSWORD=
DB_PEDIDOS_DATABASE=bd_api_automarco

# --- Webhook de OC de Grupo Planet (POST /api/v2/pedidos-planet) ---
# Usuario y contraseña Basic que se le entregan a Grupo Planet. La contraseña se
# guarda SOLO como hash bcrypt:
#   node -e "console.log(require('bcryptjs').hashSync('LA_CONTRASEÑA', 10))"
# (el hash tiene signos $: en el .env ponerlo entre comillas simples)
PLANET_BASIC_USER=
PLANET_BASIC_PASS_HASH=
# RUT de Grupo Planet como cliente nuestro (formato 12345678-9), con el que se
# crean los pedidos
PLANET_CLIENTE_RUT=
# Nombre de transporte que se asigna a los pedidos de Planet (la OC no lo trae)
PLANET_TRANSPORTE=GRUPO PLANET
# Carpeta donde se guarda el PDF de cada OC (default: ./storage/planet_oc)
PLANET_PDF_DIR=
# Correos que reciben el aviso cuando una OC no se pudo procesar (separados por coma)
NOTIFICAR_PLANET_A=
# scripts/envioPdfPlanet.js (cron): destinatarios del PDF de la OC por empresa
# (UNIFICADO y FRENOS usan los de GABTEC; una empresa sin variable no envia) y
# fecha desde la que se toman los pedidos (AAAA-MM-DD)
PLANET_PDF_ENVIO_A_AUTOMARCO=
PLANET_PDF_ENVIO_A_AUTOTEC=
PLANET_PDF_ENVIO_A_GABTEC=
PLANET_PDF_ENVIO_DESDE=

# --- Correo saliente (avisos). Si SMTP_HOST queda vacio, los avisos solo van a consola ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Descuentos ---
# RUTs (formato 12345678-9, separados por coma) a los que se les aplica su % de
# descuento en TODOS los productos de /pedidos, incluidos los netos (prod_desc = 1).
RUTS_DESCUENTO_SIN_EXCEPCION=77234743-K
